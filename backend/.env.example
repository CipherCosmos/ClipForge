## Database
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge@localhost:5432/clipforge
DATABASE_URL_SYNC=postgresql+psycopg2://clipforge:clipforge@localhost:5432/clipforge

## Cache & Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

## Storage (MinIO local / S3-compatible cloud)
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=clipforge
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=clipforge-media

## JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

## CORS
CORS_ORIGINS=*

## Database Pool
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

## AI — Groq Cloud (fastest option, free tier available)
GROQ_API_KEY=gsk_your_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

## AI — Local Whisper (fallback)
WHISPER_MODEL_SIZE=large-v3-turbo

## AI — Ollama (local LLM, fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

## AI — SenseVoice (local emotion/audio events)
SENSEVOICE_DEVICE=auto

## Monitoring & Error Tracking
SENTRY_DSN=
ENVIRONMENT=development

## Email (Resend primary, SendGrid fallback)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_key_here
SENDGRID_API_KEY=
FROM_EMAIL=noreply@clipforge.app
FRONTEND_URL=http://localhost:3000

## Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRO_PRICE_ID=price_monthly_pro
STRIPE_PRO_MONTHLY_PRICE=999
STRIPE_PRO_YEARLY_PRICE=9999

## Cloud Storage (Supabase — optional, replaces MinIO)
# SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

## Cloud Redis (Upstash — optional, replaces local Redis)
# UPSTASH_REDIS_REST_URL=https://your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-token
